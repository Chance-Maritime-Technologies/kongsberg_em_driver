<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kongsberg_em_driver</name>
  <version>0.1.0</version>
  <description>The kongsberg_em_driver package</description>

  <maintainer email="nobody@nowhere.com">NONE</maintainer>

  <license>BSD</license>

  <url type="website">http://www.whoi.edu</url>

  <author email="axd@robopec.com">A. Durbec</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <depend>ds_core_msgs</depend>
  <depend>ds_multibeam_msgs</depend>
  <depend>ds_kongsberg_msgs</depend>
  <depend>libboost-system-dev</depend>

  <!-- Used by launch/kongsberg_2040.launch.py -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
